{% import 'components/form/fields_macros.html.twig' as fields %}

<form name="form" method="post" action="{{ target }}">
   <input type="hidden" name="id" value="{{ id }}">

   <div class="card">
      <div class="card-header">
         <h3 class="card-title">{{ __('Configuration purchase request', 'purchaserequest') }}</h3>
      </div>
      <div class="card-body">
         {{ fields.htmlField(
            'id_general_service_manager',
            manager_dropdown,
            __('General Services Manager', 'purchaserequest')
         ) }}
      </div>
      <div class="card-footer d-flex justify-content-end">
         <button type="submit" name="update_config" class="btn btn-primary">
            <i class="ti ti-device-floppy"></i>
            <span>{{ _x('button', 'Save') }}</span>
         </button>
      </div>
   </div>

   <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>
