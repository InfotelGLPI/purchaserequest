{# Sub form of the purchase request massive actions (link / delete_link / validate). #}
<div class="d-flex flex-column align-items-start gap-2">
   {% if action == 'link' %}
      {{ order_itemtype|itemtype_dropdown({'name': 'plugin_order_orders_id'}) }}
   {% elseif action == 'validate' %}
      {% do call('CommonITILValidation::dropdownStatus', ['status']) %}
   {% endif %}
   <button type="submit" name="massiveaction" value="1" class="btn btn-primary">{{ _x('button', 'Post') }}</button>
</div>
