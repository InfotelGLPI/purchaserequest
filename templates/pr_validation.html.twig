<form name="form" id="formvalidation" method="post" action="{{ target }}">
   <div class="center">
      <table class="tab_cadre_fixe">
         <tr class="tab_bg_2">
            <th colspan="3">{{ __('Do you approve this purchase request ?', 'purchaserequest') }}</th>
         </tr>
         <tr class="tab_bg_1">
            <td colspan="2">{{ __('Approval requester') }}</td>
            <td class="center">{{ requester_name }}</td>
         </tr>
         <tr class="tab_bg_1">
            <td colspan="2">{{ __('Approver') }}</td>
            <td class="center">{{ approver_name }}</td>
         </tr>

         {% if can_validate %}
            <tr class="tab_bg_1">
               <td>{{ __('Status of the approval request') }}</td>
               <td class="center">
                  <div style="color:forestgreen">
                     <i id="accept_purchaserequest" class="question far fa-check-circle fa-3x"></i><br>
                     {{ __('Accept purchase request', 'purchaserequest') }}
                  </div>
                  <input type="hidden" name="accept_purchaserequest" value="0">
               </td>
               <td class="center">
                  <div style="color:darkred">
                     <i id="refuse_purchaserequest" class="question far fa-times-circle fa-3x"></i><br>
                     {{ __('Refuse purchase request', 'purchaserequest') }}
                  </div>
                  <input type="hidden" name="refuse_purchaserequest" value="0">
               </td>
            </tr>
            <tr class="tab_bg_1">
               <td>{{ __('Approval comments') }}</td>
               <td colspan="2">
                  {{ comment_field|raw }}
                  <input type="hidden" name="id" value="{{ id }}">
               </td>
            </tr>
         {% else %}
            <tr class="tab_bg_1">
               <td colspan="2">{{ __('Status of the approval request') }}</td>
               <td class="center">
                  {% if status_code == constant('CommonITILValidation::ACCEPTED') %}
                     <div style="color:forestgreen"><i class="far fa-check-circle fa-3x"></i><br>{{ status_label }}</div>
                  {% elseif status_code == constant('CommonITILValidation::REFUSED') %}
                     <div style="color:darkred"><i class="far fa-times-circle fa-3x"></i><br>{{ status_label }}</div>
                  {% else %}
                     <div style="color:orange"><i class="far fa-question-circle fa-3x"></i><br>{{ status_label }}</div>
                  {% endif %}
               </td>
            </tr>
            {% if show_validation_comment %}
               <tr class="tab_bg_1">
                  <td colspan="2">{{ __('Approval comments') }}</td>
                  <td>{{ comment_validation }}</td>
               </tr>
            {% endif %}
         {% endif %}
      </table>
   </div>

   <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>
