{% import 'components/form/fields_macros.html.twig' as fields %}

<form name="form" id="formvalidation" method="post" action="{{ target }}">
   <div class="center">
      <table class="tab_cadre_fixe">
         {% if show_actions %}
            <tr class="tab_bg_1">
               <td>{{ __('Status of the approval request') }}</td>
               <td class="center">
                  <button type="submit" name="accept_purchaserequest" value="1" class="btn btn-ghost-success flex-column">
                     <i class="far fa-check-circle fa-3x"></i>
                     <span>{{ __('Accept purchase request', 'purchaserequest') }}</span>
                  </button>
               </td>
               <td class="center">
                  <button type="submit" name="refuse_purchaserequest" value="1" class="btn btn-ghost-danger flex-column">
                     <i class="far fa-times-circle fa-3x"></i>
                     <span>{{ __('Refuse purchase request', 'purchaserequest') }}</span>
                  </button>
               </td>
            </tr>
            <tr class="tab_bg_1">
               <td>{{ __('Approval comments') }}</td>
               <td colspan="2">
                  {{ fields.textareaField('comment_validation', '', '', {
                     'no_label': true,
                     'full_width': true,
                     'rows': 3,
                  }) }}
                  {{ fields.hiddenField('id', validation_id) }}
                  {{ fields.hiddenField('users_id_validate', users_id_validate) }}
                  {{ fields.hiddenField('plugin_purchaserequest_purchaserequests_id', pr_id) }}
                  {{ fields.hiddenField('update_status', 1) }}
               </td>
            </tr>
         {% endif %}
      </table>
   </div>

   <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>
