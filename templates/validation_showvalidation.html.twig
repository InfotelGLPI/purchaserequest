{% import 'components/form/fields_macros.html.twig' as fields %}

<form name="form" id="formvalidation" method="post" action="{{ target }}">
   <div class="center">
      <table class="tab_cadre_fixe">
         {% if show_actions %}
            <tr class="tab_bg_1">
               <td>{{ __('Status of the approval request') }}</td>
               <td class="center">
                  <div style="color:forestgreen">
                     <i id="accept_purchaserequest" class="question far fa-check-circle fa-3x"></i><br>
                     {{ __('Accept purchase request', 'purchaserequest') }}
                  </div>
                  <input type="hidden" name="accept_purchaserequest" value="0">
               </td>
               <td class="center">
                  <div style="color:darkred">
                     <i id="refuse_purchaserequest" class="question far fa-times-circle fa-3x"></i><br>
                     {{ __('Refuse purchase request', 'purchaserequest') }}
                  </div>
                  <input type="hidden" name="refuse_purchaserequest" value="0">
               </td>
            </tr>
            <tr class="tab_bg_1">
               <td>{{ __('Approval comments') }}</td>
               <td colspan="2">
                  {{ comment_field|raw }}
                  <input type="hidden" name="id" value="{{ validation_id }}">
                  <input type="hidden" name="users_id_validate" value="{{ users_id_validate }}">
                  <input type="hidden" name="plugin_purchaserequest_purchaserequests_id" value="{{ pr_id }}">
               </td>
            </tr>
         {% endif %}
      </table>
   </div>

   <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>
