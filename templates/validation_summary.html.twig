{% import 'components/form/fields_macros.html.twig' as fields %}

<div id="viewvalidation{{ tID }}{{ rand }}"></div>

<table class="tab_cadre_fixehov">
   <tr class="noHover">
      <th colspan="{{ columns|length }}">{{ title }}</th>
   </tr>

   {% if entries|length > 0 %}
      <tr>
         {% for col in columns %}
            <th>{{ col }}</th>
         {% endfor %}
      </tr>

      {% for entry in entries %}
         <tr class="tab_bg_1">
            <td><div style="background-color: {{ entry.bgcolor|e('html_attr') }};">{{ entry.status|raw }}</div></td>
            <td>{{ entry.submission_date }}</td>
            <td>{{ entry.requester }}</td>
            <td>{{ entry.validation_date }}</td>
            <td>{{ entry.validator }}</td>
            <td>{{ entry.comment }}</td>
         </tr>
      {% endfor %}

      <tr>
         {% for col in columns %}
            <th>{{ col }}</th>
         {% endfor %}
      </tr>
   {% else %}
      <tr class="tab_bg_1 noHover">
         <th colspan="{{ columns|length }}">{{ __('No results found') }}</th>
      </tr>
   {% endif %}
</table>
