{% if not canread or entries|length == 0 %}
   <div class="alert alert-info d-flex">{{ __('No results found') }}</div>
{% else %}
   <div class="center">
      <form method="post" name="{{ form_name }}" id="{{ form_name }}" action="{{ target }}">
         <table class="tab_cadre_fixe">
            <tr class="tab_bg_1 center">
               <th colspan="13">{{ typename }}</th>
            </tr>
            <tr class="tab_bg_1">
               {% if canedit %}<th></th>{% endif %}
               <th>{{ __('Name') }}</th>
               <th>{{ __('Requester') }}</th>
               <th>{{ __('Requester group') }}</th>
               <th>{{ __('Location') }}</th>
               <th>{{ __('Status') }}</th>
               <th>{{ __('Item type') }}</th>
               <th>{{ __('Type') }}</th>
               <th>{{ __('Due date', 'purchaserequest') }}</th>
               <th>{{ __('Treated on', 'purchaserequest') }}</th>
               <th>{{ __('Approver') }}</th>
               <th>{{ __('Approval status') }}</th>
               <th>{{ order_typename }}</th>
            </tr>

            {% for entry in entries %}
               <tr class="tab_bg_1">
                  {% if canedit %}
                     <td width="10">
                        <input type="checkbox" name="item[{{ entry.id }}]" value="1" {{ entry.checked ? 'checked' : '' }}>
                     </td>
                  {% endif %}
                  <td>{{ entry.name|raw }}</td>
                  <td>{{ entry.requester }}</td>
                  <td>{{ entry.group }}</td>
                  <td>{{ entry.location }}</td>
                  <td>{{ entry.state }}</td>
                  <td>{{ entry.item_type }}</td>
                  <td>{{ entry.type }}</td>
                  <td>{{ entry.due_date }}</td>
                  <td>{{ entry.processing_date }}</td>
                  <td>{{ entry.validator }}</td>
                  <td>{{ entry.status }}</td>
                  <td>{{ entry.order|raw }}</td>
               </tr>
            {% endfor %}
         </table>

         {% if canedit %}
            <div class="left">
               <table width="950px" class="left">
                  <tr>
                     <td><img src="{{ arrow_src }}" alt=""></td>
                     <td class="center">
                        <a onclick="if ( markCheckboxes('{{ form_name }}') ) return false;" href="#">{{ __('Check all') }}</a>
                     </td>
                     <td>/</td>
                     <td class="center">
                        <a onclick="if ( unMarkCheckboxes('{{ form_name }}') ) return false;" href="#">{{ __('Uncheck all') }}</a>
                     </td>
                     <td align="left" width="80%">
                        {{ action_dropdown|raw }}
                        &nbsp;
                        <button type="submit" name="action" value="1" class="btn btn-primary">
                           {{ _x('button', 'Post') }}
                        </button>
                     </td>
                  </tr>
               </table>
            </div>
            <input type="hidden" name="plugin_order_orders_id" value="{{ plugin_order_orders_id }}">
         {% endif %}

         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      </form>
   </div>
{% endif %}
